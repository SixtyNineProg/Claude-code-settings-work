&lt;ToolboxItemSettings DisplayName="initOrder" InternalName="MyBlock87701bd58f1c4b7989c94cd953c511d9" FriendlyName="&amp;#xA;Запускает Java-шаг с транзакцией&amp;#xA;" Width="200" Height="75" PathToImage="data:" PathToToolboxImage="data:" ImageType="LeftImage" NoDelete="False" Invisible="False" Proportional="False" Version="465" LinuxAvailable="True" Code="&amp;#xA;function MyBlock87701bd58f1c4b7989c94cd953c511d9{{{block_id}}}&amp;#xA;{    &amp;#xA; $__IsNormalExit = $true;&amp;#xA;    $__Error.Enter(&amp;quot;{{{block_native_id}}}&amp;quot;, &amp;quot;{{{ErrorLevel}}}&amp;quot;,&amp;quot;{{{ErrorDirection}}}&amp;quot;,&amp;quot;{{{ReportLevel}}}&amp;quot;,&amp;quot;{{{ErrorMessage}}}&amp;quot;);&amp;#xA;    $__Error.AddConnectors(&amp;quot;{{{connector-Error}}}&amp;quot;, &amp;quot;{{{connectorRight}}}&amp;quot;, &amp;quot;{{{connectorBottom}}}&amp;quot;); &amp;#xA;    &amp;#xA; #__StartPropertiesZone&amp;#xA;$StepName={{{StepName}}};&amp;#xA;$InitParamsAssetName={{{InitParamsAssetName}}};&amp;#xA;$EmailTemplatesAssetName={{{EmailTemplatesAssetName}}};&amp;#xA;$Args={{{Args}}};&amp;#xA;$StepsPath={{{StepsPath}}};&amp;#xA;$JarPath={{{JarPath}}};&amp;#xA;$Resume=${{{Resume}}};&amp;#xA;$__JobGuid={{{__JobGuid}}};&amp;#xA;$MaxRetries={{{MaxRetries}}};&amp;#xA;$RetryDelayMs={{{RetryDelayMs}}};&amp;#xA;$SaveTransaction=${{{SaveTransaction}}};&amp;#xA;#__EndPropertiesZone&amp;#xA; &amp;#xA;    try&amp;#xA; {&amp;#xA;  #__StartCodeZone&amp;#xA;# ================================&amp;#xA;# Logging&amp;#xA;# ================================&amp;#xA;&amp;#xA;function Send-ToOrchestrator&amp;#xA;{&amp;#xA;    param(&amp;#xA;        [string]$Message,&amp;#xA;        [string]$LogType = &amp;quot;Info&amp;quot;&amp;#xA;    )&amp;#xA;&amp;#xA;    $escapedMessage = [System.Security.SecurityElement]::Escape($Message)&amp;#xA;    $xmlMessage = &amp;quot;&amp;lt;block&amp;gt;&amp;lt;ID&amp;gt;$( New-Guid )&amp;lt;/ID&amp;gt;&amp;lt;InternalName&amp;gt;SendLogOrkest&amp;lt;/InternalName&amp;gt;&amp;lt;UITextValue&amp;gt;$escapedMessage&amp;lt;/UITextValue&amp;gt;&amp;lt;UITextType&amp;gt;$LogType&amp;lt;/UITextType&amp;gt;&amp;lt;IsScreenshot&amp;gt;False&amp;lt;/IsScreenshot&amp;gt;&amp;lt;/block&amp;gt;&amp;quot;&amp;#xA;    Write-Host $xmlMessage&amp;#xA;}&amp;#xA;&amp;#xA;function Write-StdLog&amp;#xA;{&amp;#xA;    param(&amp;#xA;        [string]$Message&amp;#xA;    )&amp;#xA;    _SendLog $Message&amp;#xA;    Send-ToOrchestrator -Message $Message -LogType &amp;quot;Info&amp;quot;&amp;#xA;}&amp;#xA;&amp;#xA;function Write-ErrorLog&amp;#xA;{&amp;#xA;    param(&amp;#xA;        [string]$Message&amp;#xA;    )&amp;#xA;    _SendLog $Message&amp;#xA;    Send-ToOrchestrator -Message $Message -LogType &amp;quot;Error&amp;quot;&amp;#xA;}&amp;#xA;&amp;#xA;# ================================&amp;#xA;# Reflection / Helpers&amp;#xA;# ================================&amp;#xA;&amp;#xA;function Get-NestedMemberValue&amp;#xA;{&amp;#xA;    param(&amp;#xA;        [Parameter(Mandatory = $true)][object]$Object,&amp;#xA;        [Parameter(Mandatory = $true)][string]$Path&amp;#xA;    )&amp;#xA;&amp;#xA;    if (-not $Object)&amp;#xA;    {&amp;#xA;        return $null&amp;#xA;    }&amp;#xA;&amp;#xA;    $current = $Object&amp;#xA;    $parts = $Path -split '\.'&amp;#xA;    $bind = [Reflection.BindingFlags]::Public -bor [Reflection.BindingFlags]::NonPublic -bor [Reflection.BindingFlags]::Instance&amp;#xA;&amp;#xA;    foreach ($part in $parts)&amp;#xA;    {&amp;#xA;        if (-not $current)&amp;#xA;        {&amp;#xA;            return $null&amp;#xA;        }&amp;#xA;&amp;#xA;        if ($current -is [string] -or $current.GetType().IsPrimitive)&amp;#xA;        {&amp;#xA;            return $current&amp;#xA;        }&amp;#xA;&amp;#xA;        $prop = $current.PSObject.Properties[$part]&amp;#xA;        if ($prop)&amp;#xA;        {&amp;#xA;            $current = $prop.Value; continue&amp;#xA;        }&amp;#xA;&amp;#xA;        $field = $current.GetType().GetField($part, $bind)&amp;#xA;        if ($field)&amp;#xA;        {&amp;#xA;            $current = $field.GetValue($current); continue&amp;#xA;        }&amp;#xA;&amp;#xA;        $property = $current.GetType().GetProperty($part, $bind)&amp;#xA;        if ($property)&amp;#xA;        {&amp;#xA;            $current = $property.GetValue($current); continue&amp;#xA;        }&amp;#xA;&amp;#xA;        return $null&amp;#xA;    }&amp;#xA;&amp;#xA;    return $current&amp;#xA;}&amp;#xA;&amp;#xA;# ================================&amp;#xA;# Sherpa Asset&amp;#xA;# ================================&amp;#xA;&amp;#xA;function Get-SherpaAsset&amp;#xA;{&amp;#xA;    param (&amp;#xA;        [Parameter(Mandatory = $true)][string]$AssetGuid,&amp;#xA;        [int]$Timeout = 300&amp;#xA;    )&amp;#xA;&amp;#xA;    if (-not $script:__Orchestrator)&amp;#xA;    {&amp;#xA;        $script:__Orchestrator = [MainHelpers.ClassOrchestrator]::new()&amp;#xA;    }&amp;#xA;&amp;#xA;    $script:__Orchestrator.Timeout = $Timeout&amp;#xA;    $script:__Orchestrator.OrchestratorV = $script:__OrchestratorV&amp;#xA;    $script:__Orchestrator.JobGuid = $script:__JobGuid&amp;#xA;&amp;#xA;    try&amp;#xA;    {&amp;#xA;        $psResult = $script:__Orchestrator.Initialize()&amp;#xA;        if ( $__Error.CheckResult($psResult))&amp;#xA;        {&amp;#xA;            throw &amp;quot;Failed to initialize Orchestrator&amp;quot;&amp;#xA;        }&amp;#xA;&amp;#xA;        $psResult = $script:__Orchestrator.GetAsset($AssetGuid)&amp;#xA;        if ( $__Error.CheckResult($psResult))&amp;#xA;        {&amp;#xA;            throw &amp;quot;Failed to get asset: $AssetGuid&amp;quot;&amp;#xA;        }&amp;#xA;&amp;#xA;        $item = $__BinFormatter.frombin($psResult.Result)&amp;#xA;        if (-not $item)&amp;#xA;        {&amp;#xA;            throw &amp;quot;Asset '$AssetGuid' returned null or invalid data&amp;quot;&amp;#xA;        }&amp;#xA;&amp;#xA;        Write-StdLog &amp;quot;[INFO] Successfully retrieved asset '$AssetGuid'.&amp;quot;&amp;#xA;        return $item&amp;#xA;    }&amp;#xA;    catch&amp;#xA;    {&amp;#xA;        $msg = &amp;quot;[ERROR] Failed to retrieve Sherpa asset '$AssetGuid': $( $_.Exception.Message )&amp;quot;&amp;#xA;        Write-ErrorLog $msg&amp;#xA;        throw $msg&amp;#xA;    }&amp;#xA;}&amp;#xA;&amp;#xA;# ================================&amp;#xA;# Java Step Execution&amp;#xA;# ================================&amp;#xA;&amp;#xA;function Invoke-JavaStep&amp;#xA;{&amp;#xA;    param(&amp;#xA;        [string]$StepName,&amp;#xA;        [string]$JarPath,&amp;#xA;        [string]$TransactionFile,&amp;#xA;        [string]$StepsPath,&amp;#xA;        [string]$ArgsString,&amp;#xA;        [string]$ServerUrl,&amp;#xA;        [string]$BearerToken,&amp;#xA;        [string]$JobGuid&amp;#xA;    )&amp;#xA;&amp;#xA;    $process = $null&amp;#xA;&amp;#xA;    function Write-ErrorBuffer&amp;#xA;    {&amp;#xA;        param($buffer)&amp;#xA;        if ($buffer.Count -gt 0)&amp;#xA;        {&amp;#xA;            $joined = $buffer -join &amp;quot;`n&amp;quot;&amp;#xA;            _SendLog &amp;quot;[ERROR BLOCK]`n$joined&amp;quot;&amp;#xA;            Send-ToOrchestrator -Message $joined -LogType &amp;quot;Error&amp;quot;&amp;#xA;            $buffer.Clear()&amp;#xA;        }&amp;#xA;    }&amp;#xA;&amp;#xA;    try&amp;#xA;    {&amp;#xA;        $EscapedJarPath = if ($JarPath -match ' ')&amp;#xA;        {&amp;#xA;            &amp;quot;`&amp;quot;$JarPath`&amp;quot;&amp;quot;&amp;#xA;        }&amp;#xA;        else&amp;#xA;        {&amp;#xA;            $JarPath&amp;#xA;        }&amp;#xA;        $EscapedTransactionFile = if ($TransactionFile -match ' ')&amp;#xA;        {&amp;#xA;            &amp;quot;`&amp;quot;$TransactionFile`&amp;quot;&amp;quot;&amp;#xA;        }&amp;#xA;        else&amp;#xA;        {&amp;#xA;            $TransactionFile&amp;#xA;        }&amp;#xA;&amp;#xA;        $JavaArgs = @(&amp;#xA;            &amp;quot;-Dfile.encoding=UTF-8&amp;quot;,&amp;#xA;            &amp;quot;-Dsun.stdout.encoding=UTF-8&amp;quot;,&amp;#xA;            &amp;quot;-Dsun.stderr.encoding=UTF-8&amp;quot;,&amp;#xA;            &amp;quot;-Djob.guid=$JobGuid&amp;quot;&amp;#xA;            &amp;quot;-Dtransaction.path=$EscapedTransactionFile&amp;quot;,&amp;#xA;            &amp;quot;-Dstep.package=$StepsPath&amp;quot;,&amp;#xA;            &amp;quot;-Dinitial.parameters=$InitParamsAssetName&amp;quot;,&amp;#xA;            &amp;quot;-Demail.templates=$EmailTemplatesAssetName&amp;quot;,&amp;#xA;            &amp;quot;-Dsherpa.api.bearer=$BearerToken&amp;quot;,&amp;#xA;            &amp;quot;-Dserver.url=$ServerUrl&amp;quot;,&amp;#xA;            &amp;quot;-jar&amp;quot;, $EscapedJarPath,&amp;#xA;            $StepName,&amp;#xA;            $ArgsString&amp;#xA;        )&amp;#xA;&amp;#xA;        Write-StdLog &amp;quot;[JAVA] Starting Java process for step: $StepName&amp;quot;&amp;#xA;        Write-StdLog &amp;quot;[JAVA] Command: java $( $JavaArgs -join ' ' )&amp;quot;&amp;#xA;&amp;#xA;        $startInfo = [System.Diagnostics.ProcessStartInfo]::new(&amp;#xA;                &amp;quot;java&amp;quot;,&amp;#xA;                ($JavaArgs -join ' ')&amp;#xA;        )&amp;#xA;        $startInfo.RedirectStandardOutput = $true&amp;#xA;        $startInfo.UseShellExecute = $false&amp;#xA;        $startInfo.CreateNoWindow = $true&amp;#xA;        $startInfo.StandardOutputEncoding = [System.Text.UTF8Encoding]::new($false)&amp;#xA;&amp;#xA;        $process = [System.Diagnostics.Process]::new()&amp;#xA;        $process.StartInfo = $startInfo&amp;#xA;        $process.Start() | Out-Null&amp;#xA;&amp;#xA;        Write-StdLog &amp;quot;[PROCESS] Java started successfully&amp;quot;&amp;#xA;&amp;#xA;        $stdout = $process.StandardOutput&amp;#xA;        $output = New-Object System.Text.StringBuilder&amp;#xA;        $errorBuffer = New-Object System.Collections.Generic.List[string]&amp;#xA;        $inErrorBlock = $false&amp;#xA;        $nonErrorLineCount = 0&amp;#xA;&amp;#xA;        while (-not $process.HasExited -or -not $stdout.EndOfStream)&amp;#xA;        {&amp;#xA;            while (-not $stdout.EndOfStream)&amp;#xA;            {&amp;#xA;                $line = $stdout.ReadLine()&amp;#xA;                if (-not $line)&amp;#xA;                {&amp;#xA;                    continue&amp;#xA;                }&amp;#xA;                $output.AppendLine($line) | Out-Null&amp;#xA;&amp;#xA;                $isErrorLine = $line -match 'Exception|^\s*at\s|^\s*Caused by:|^\s*Suppressed:|(^|\[)ERROR[:\s]|^\s*\.\.\. \d+ common frames omitted'&amp;#xA;&amp;#xA;                if ($isErrorLine)&amp;#xA;                {&amp;#xA;                    $inErrorBlock = $true&amp;#xA;                    $nonErrorLineCount = 0&amp;#xA;                    $errorBuffer.Add($line)&amp;#xA;                }&amp;#xA;                elseif ($inErrorBlock)&amp;#xA;                {&amp;#xA;                    $nonErrorLineCount++&amp;#xA;                    $errorBuffer.Add($line)&amp;#xA;                    if ($nonErrorLineCount -ge 2)&amp;#xA;                    {&amp;#xA;                        Write-ErrorBuffer -buffer $errorBuffer&amp;#xA;                        $inErrorBlock = $false&amp;#xA;                        $nonErrorLineCount = 0&amp;#xA;                    }&amp;#xA;                }&amp;#xA;                else&amp;#xA;                {&amp;#xA;                    Write-StdLog &amp;quot;[STDOUT] $line&amp;quot;&amp;#xA;                }&amp;#xA;            }&amp;#xA;            Start-Sleep -Milliseconds 50&amp;#xA;        }&amp;#xA;&amp;#xA;        if ($inErrorBlock)&amp;#xA;        {&amp;#xA;            Write-ErrorBuffer -buffer $errorBuffer&amp;#xA;        }&amp;#xA;&amp;#xA;        return @{&amp;#xA;            ExitCode = $process.ExitCode&amp;#xA;            Output = $output.ToString()&amp;#xA;            Success = ($process.ExitCode -eq 0)&amp;#xA;        }&amp;#xA;    }&amp;#xA;    catch&amp;#xA;    {&amp;#xA;        if ($process -and (-not $process.HasExited))&amp;#xA;        {&amp;#xA;            $process.Kill($true) | Out-Null&amp;#xA;        }&amp;#xA;        throw&amp;#xA;    }&amp;#xA;    finally&amp;#xA;    {&amp;#xA;        if ($process)&amp;#xA;        {&amp;#xA;            $process.Dispose()&amp;#xA;        }&amp;#xA;    }&amp;#xA;}&amp;#xA;&amp;#xA;# ================================&amp;#xA;# Main Step Execution&amp;#xA;# ================================&amp;#xA;&amp;#xA;try&amp;#xA;{&amp;#xA;    $ErrorActionPreference = &amp;quot;Stop&amp;quot;&amp;#xA;&amp;#xA;    # Sherpa assets&amp;#xA;    $apiKeyAsset = Get-SherpaAsset -AssetGuid &amp;quot;sherpa_api_credentials&amp;quot;&amp;#xA;    $Global:SherpaApiKey = $apiKeyAsset.login&amp;#xA;    $Global:ShepaApiBearer = $apiKeyAsset.password&amp;#xA;    $Global:SherpaApiExpiration = $apiKeyAsset.PasswordExpiration&amp;#xA;    $Global:ServerUrl = Get-NestedMemberValue -Object $script:__Orchestrator -Path &amp;quot;OrkestrServer.Name&amp;quot;&amp;#xA;&amp;#xA;    Write-StdLog &amp;quot;[INFO] Successfully initialized Sherpa credentials.&amp;quot;&amp;#xA;&amp;#xA;    # Transaction&amp;#xA;    if (-not $Global:TransactionFile)&amp;#xA;    {&amp;#xA;        if (-not $__JobGuid)&amp;#xA;        {&amp;#xA;            $__JobGuid = [guid]::NewGuid().ToString()&amp;#xA;        }&amp;#xA;        $TransactionPath = Join-Path $env:TEMP &amp;quot;transaction_$__JobGuid.json&amp;quot;&amp;#xA;        if (-not (Test-Path $TransactionPath))&amp;#xA;        {&amp;#xA;            '{&amp;quot;executionHistory&amp;quot;:[],&amp;quot;stepData&amp;quot;:{},&amp;quot;initParameters&amp;quot;:{}}' | Out-File -Encoding UTF8 $TransactionPath -ErrorAction Stop&amp;#xA;        }&amp;#xA;        $Global:TransactionFile = $TransactionPath&amp;#xA;        Write-StdLog &amp;quot;[INIT] TransactionFile: $TransactionPath&amp;quot;&amp;#xA;    }&amp;#xA;&amp;#xA;    # Resume&amp;#xA;    $TransactionJson = Get-Content $Global:TransactionFile -Raw -ErrorAction Stop | ConvertFrom-Json&amp;#xA;    $stepExecuted = $TransactionJson.executionHistory | Where-Object { $_.stepName -eq $StepName }&amp;#xA;&amp;#xA;    if ($Resume -and $stepExecuted -and $stepExecuted.status -eq &amp;quot;SUCCESS&amp;quot;)&amp;#xA;    {&amp;#xA;        $msg = &amp;quot;[RESUME] Step '$StepName' already completed successfully. Skipping...&amp;quot;&amp;#xA;        Write-StdLog $msg&amp;#xA;        return&amp;#xA;    }&amp;#xA;&amp;#xA;    # Resolve Inputs&amp;#xA;    if ($StepsPath -like &amp;quot;*`**&amp;quot;)&amp;#xA;    {&amp;#xA;        $folder = Get-ChildItem &amp;quot;src/main/java/by/a1&amp;quot; -Directory | Select-Object -First 1 | Select-Object -ExpandProperty Name&amp;#xA;        if (-not $folder)&amp;#xA;        {&amp;#xA;            throw &amp;quot;[ERROR] No subfolder found in 'src/main/java/by/a1'&amp;quot;&amp;#xA;        }&amp;#xA;        $StepsPath = $StepsPath -replace &amp;quot;\*&amp;quot;, $folder&amp;#xA;    }&amp;#xA;    if ($JarPath -notmatch &amp;quot;\.jar$&amp;quot;)&amp;#xA;    {&amp;#xA;        $jarFile = Get-ChildItem $JarPath -Filter *.jar | Select-Object -First 1&amp;#xA;        if (-not $jarFile)&amp;#xA;        {&amp;#xA;            throw &amp;quot;[ERROR] No JAR file found in directory '$JarPath'&amp;quot;&amp;#xA;        }&amp;#xA;        $JarPath = $jarFile.FullName&amp;#xA;    }&amp;#xA;&amp;#xA;    $EscapedArgs = '&amp;quot;' + $Args.Replace('&amp;quot;', '\&amp;quot;').Replace('`', '\`') + '&amp;quot;'&amp;#xA;&amp;#xA;    Write-StdLog &amp;quot;[START] Step: $StepName, TransactionFile: $Global:TransactionFile, Jar: $JarPath&amp;quot;&amp;#xA;&amp;#xA;    # Execute Java&amp;#xA;    $result = Invoke-JavaStep -StepName $StepName `&amp;#xA;        -JarPath $JarPath `&amp;#xA;        -TransactionFile $Global:TransactionFile `&amp;#xA;        -StepsPath $StepsPath `&amp;#xA;        -ArgsString $EscapedArgs `&amp;#xA;        -ServerUrl $Global:ServerUrl `&amp;#xA;        -BearerToken $Global:ShepaApiBearer `&amp;#xA;        -JobGuid $__JobGuid&amp;#xA;&amp;#xA;    if (-not $result.Success)&amp;#xA;    {&amp;#xA;        throw &amp;quot;[JAVA PROCESS FAILED] Exit code: $( $result.ExitCode )&amp;quot;&amp;#xA;    }&amp;#xA;&amp;#xA;    # Transaction check&amp;#xA;    $transactionJsonAfter = Get-Content $Global:TransactionFile -Raw -ErrorAction Stop | ConvertFrom-Json&amp;#xA;    $stepStatusAfter = $transactionJsonAfter.executionHistory | Where-Object { $_.stepName -eq $StepName } | Select-Object -Last 1&amp;#xA;&amp;#xA;    if (-not $stepStatusAfter)&amp;#xA;    {&amp;#xA;        throw &amp;quot;[ERROR] Step '$StepName' execution not recorded in transaction history.&amp;quot;&amp;#xA;    }&amp;#xA;    if ($stepStatusAfter.status -eq &amp;quot;FAILED&amp;quot;)&amp;#xA;    {&amp;#xA;        throw &amp;quot;[ERROR] Step '$StepName' failed according to transaction history.&amp;quot;&amp;#xA;    }&amp;#xA;&amp;#xA;    if ($stepStatusAfter.status -eq &amp;quot;SUCCESS&amp;quot;)&amp;#xA;    {&amp;#xA;        Write-StdLog &amp;quot;[SUCCESS] Step '$StepName' completed successfully&amp;quot;&amp;#xA;    }&amp;#xA;    else&amp;#xA;    {&amp;#xA;        throw &amp;quot;[ERROR] Unknown status for step '$StepName': $( $stepStatusAfter.status )&amp;quot;&amp;#xA;    }&amp;#xA;}&amp;#xA;catch&amp;#xA;{&amp;#xA;    $msg = &amp;quot;[UNHANDLED ERROR] $( $_.Exception.Message )&amp;quot;&amp;#xA;    Write-ErrorLog $msg&amp;#xA;    throw $msg&amp;#xA;}&amp;#xA;#__EndCodeZone&amp;#xA; }&amp;#xA; catch &amp;#xA;    { &amp;#xA;  $__IsNormalExit = $false;&amp;#xA;        $__Error.ExceptionCatch($_);&amp;#xA;        return;&amp;#xA;    }&amp;#xA;    finally&amp;#xA; {&amp;#xA;  if($__IsNormalExit) &amp;#xA;  {&amp;#xA;  &amp;#xA; #__StartOutputZone&amp;#xA;&amp;#xA;#__EndOutputZone&amp;#xA;  &amp;#xA;   $__Error.Quit(); &amp;#xA;  }&amp;#xA; } &amp;#xA;}&amp;#xA;" ProtoName="" TextColor="#FF000000" Language="" UrlVideo="{x:Null}" DerivedFrom="" NoResize="False" Container="False" MouseOverColor="Gray" MouseOverFill="Transparent" IsExpressionOnPause="False" ExpressionOnPause="" IsCollapsedBlock="False" Breakpoint="False" DirivedFrom="" xmlns="clr-namespace:ToolboxDesigner.Core;assembly=DiagramDesigner" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"&gt;&lt;ToolboxItemSettings.PathStyle&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.BasedOn&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Shape.Fill"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FFFFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stroke"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FF303030&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeThickness"&gt;&lt;av:Setter.Value&gt;&lt;s:Double&gt;2&lt;/s:Double&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeLineJoin"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:PenLineJoin.Round" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stretch"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:Stretch.Fill" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.IsHitTestVisible"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;False&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.SnapsToDevicePixels"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;True&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/av:Style.BasedOn&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Path.Data"&gt;&lt;av:Setter.Value&gt;&lt;av:StreamGeometry&gt;M0,0L80,0 80,20 0,20z&lt;/av:StreamGeometry&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/ToolboxItemSettings.PathStyle&gt;&lt;ToolboxItemSettings.PathStyle_DragThumb&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.BasedOn&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.BasedOn&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Shape.Fill"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FFFFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stroke"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FF303030&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeThickness"&gt;&lt;av:Setter.Value&gt;&lt;s:Double&gt;2&lt;/s:Double&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeLineJoin"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:PenLineJoin.Round" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stretch"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:Stretch.Fill" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.IsHitTestVisible"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;False&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.SnapsToDevicePixels"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;True&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/av:Style.BasedOn&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Path.Data"&gt;&lt;av:Setter.Value&gt;&lt;av:StreamGeometry&gt;M0,0L80,0 80,20 0,20z&lt;/av:StreamGeometry&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/av:Style.BasedOn&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:UIElement.IsHitTestVisible"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;True&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Fill"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#00FFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stroke"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#00FFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/ToolboxItemSettings.PathStyle_DragThumb&gt;&lt;ToolboxItemSettings.Properties&gt;&lt;PropertiesCollection Capacity="16"&gt;&lt;Property Name="ErrorLevel" Tooltip="Выбор уровня обработки ошибок. Возможные значения: &amp;quot;Default&amp;quot; - по умолчанию; &amp;quot;Ignore&amp;quot; - ошибки игнорируются; &amp;quot;Handle&amp;quot; - ошибки обрабатываются. Если выбрано значение &amp;quot;Default&amp;quot;, то будет использоваться значение блока &amp;quot;Старт&amp;quot; данной диаграммы" CatalogName="Error processing" Type="Enum" Value="Default" Visible="True" DefaultValue="" ValueType="{x:Null}" EnumVariants="Default;Ignore;Handle" Caption="Уровень обработки" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ErrorDirection" Tooltip="Выбор направления выхода из блока при возникновении ошибки. Возможные значения: &amp;quot;Default&amp;quot; - по умолчанию; &amp;quot;Right / On Error&amp;quot; - направо или по ошибке; &amp;quot;Bottom&amp;quot; - вниз. Данное свойство позволяет определить направление выхода при возникновении ошибок для блоков не содержащих коннектора &amp;quot;Если ошибка&amp;quot; (например блок &amp;quot;Условие&amp;quot;). Если выбрано значение &amp;quot;Default&amp;quot;, то будет использоваться значение блока &amp;quot;Старт&amp;quot; данной диаграммы" CatalogName="Error processing" Type="Enum" Value="Default" Visible="True" DefaultValue="" ValueType="{x:Null}" EnumVariants="Default;Right / On Error;Bottom" Caption="Направление выхода" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ReportLevel" Tooltip="Выбор уровня сообщений, которые будут выводить блоки при работе. Возможные значения: &amp;quot;Default&amp;quot; - по умолчанию; &amp;quot;Release&amp;quot; - вывод отключен; &amp;quot;Debug&amp;quot; - вывод основной информации; &amp;quot;Detailed&amp;quot; - вывод подробной информации. Если выбрано значение &amp;quot;Default&amp;quot;, то будет использоваться значение блока &amp;quot;Старт&amp;quot; данной диаграммы" CatalogName="Error processing" Type="Enum" Value="Default" Visible="True" DefaultValue="" ValueType="{x:Null}" EnumVariants="Default;Release;Debug;Detailed" Caption="Уровень сообщений" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ErrorMessage" Tooltip="[Текст] Возвращает подробную информацию об ошибке в случае некорректного выполнения работы блока" CatalogName="Error processing" Type="Variable" Value="$ErrorMessage" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Текст ошибки" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="StepName" Tooltip="Имя Java шага для выполнения. Должно точно соответствовать значению, возвращаемому методом getName() класса шага." CatalogName="Required" Type="Expression" Value="&amp;quot;initOrder&amp;quot;" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Имя шага" ProtoName="" ReadOnly="False" IsRequired="True" IsPSVerified="True" /&gt;&lt;Property Name="InitParamsAssetName" Tooltip="Имя ассета в оркестраторе, содержащего параметры инициализации процесса в формате JSON." CatalogName="Main properties" Type="Expression" Value="&amp;quot;demo_init_params&amp;quot;" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Имя ассета параметров инициализации" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="EmailTemplatesAssetName" Tooltip="Имя ассета в оркестраторе, содержащего шаблоны email сообщений в формате JSON." CatalogName="Main properties" Type="Expression" Value="&amp;quot;demo_email_templates&amp;quot;" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Имя ассета шаблонов email сообщений" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="Args" Tooltip="Дополнительные аргументы для шага. Передаются как список строк в метод execute() Java шага." CatalogName="Main properties" Type="Expression" Value="&amp;quot;ТЕСТ&amp;quot;" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Аргуметы" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="StepsPath" Tooltip="Java пакет, в котором находятся классы шагов. Используется для автоматического сканирования и регистрации шагов." CatalogName="Required" Type="Expression" Value="&amp;quot;by.a1.*.steps&amp;quot;" Visible="True" DefaultValue="&amp;quot;by.a1.*.steps&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Путь к шагам" ProtoName="" ReadOnly="False" IsRequired="True" IsPSVerified="True" /&gt;&lt;Property Name="JarPath" Tooltip="Полный путь к JAR файлу процесса. Файл должен быть собран с помощью shadowJar и содержать все зависимости." CatalogName="Required" Type="Expression" Value="&amp;quot;build\libs&amp;quot;" Visible="True" DefaultValue="&amp;quot;build\libs&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Путь к JAR" ProtoName="" ReadOnly="False" IsRequired="True" IsPSVerified="True" /&gt;&lt;Property Name="Resume" Tooltip="Флаг возобновления процесса. Если true, шаг будет пропущен, если он уже успешно выполнен в предыдущем запуске." CatalogName="Main properties" Type="Bool" Value="True" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="{x:Null}" EnumVariants="" Caption="Режим Resume" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="__JobGuid" Tooltip="Уникальный идентификатор запуска процесса в оркестраторе. Задается автоматически при старте процесса и используется для отслеживания выполнения в логах и транзакциях." CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="$__JobGuid" ValueType="{x:Null}" EnumVariants="" Caption="GUID задания оркестратора" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="MaxRetries" Tooltip="Максимальное количество повторных попыток выполнения шага при возникновении ошибки. При значении 0 повторные попытки не выполняются." CatalogName="Main properties" Type="Number" Value="0" Visible="True" DefaultValue="0" ValueType="{x:Null}" EnumVariants="" Caption="Максимум повторов" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="RetryDelayMs" Tooltip="Задержка между повторными попытками выполнения шага в миллисекундах." CatalogName="Main properties" Type="Number" Value="1000" Visible="True" DefaultValue="1000" ValueType="{x:Null}" EnumVariants="" Caption="Задержка повтора (мс)" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="SaveTransaction" Tooltip="Сохранять состояние транзакции после успешного выполнения шага. Используется для возобновления процесса (Resume)." CatalogName="Main properties" Type="Bool" Value="True" Visible="True" DefaultValue="True" ValueType="{x:Null}" EnumVariants="" Caption="Сохранять транзакцию" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;/PropertiesCollection&gt;&lt;/ToolboxItemSettings.Properties&gt;&lt;ToolboxItemSettings.ConnectorsSettings&gt;&lt;ConnectorsSettingsCollection Capacity="4"&gt;&lt;ConnectorSettings Name="Input" Orientation="Top" RelativePosition="0.5,0" MaxInConnections="100" MaxOutConnections="0" Color="#FF000000" Caption="" /&gt;&lt;ConnectorSettings Name="Error" Orientation="Right" RelativePosition="1,0.5" MaxInConnections="0" MaxOutConnections="1" Color="#FFFF0000" Caption="Если ошибка" /&gt;&lt;ConnectorSettings Name="InputLeft" Orientation="Left" RelativePosition="0,0.5" MaxInConnections="100" MaxOutConnections="0" Color="#FF000000" Caption="" /&gt;&lt;ConnectorSettings Name="Next" Orientation="Bottom" RelativePosition="0.5,1" MaxInConnections="0" MaxOutConnections="1" Color="#FF000000" Caption="" /&gt;&lt;/ConnectorsSettingsCollection&gt;&lt;/ToolboxItemSettings.ConnectorsSettings&gt;&lt;/ToolboxItemSettings&gt;
